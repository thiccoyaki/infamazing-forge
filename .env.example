# Keys are copied from story-forge's .env automatically on first start (ELEVENLABS_API_KEY, YT_API_KEY).
# ELEVENLABS_API_KEY=sk_...
# YouTube Data API key: competitor outliers + extra YouTube reference search
# YT_API_KEY=
# Where story-forge lives (Kalemod VO settings are read from its forge.db). Default: the folder next to this one.
# STORY_FORGE_DIR=C:\Users\kurtt\Documents\Hydra LLC\GIT Repos\story-forge
# Local Drive-for-desktop path of the Google Drive folder (or set it in Settings)
# FORGE_DRIVE_DIR=G:\My Drive\Infamazing\FORGE
# Port (story-forge uses 8777)
# FORGE_PORT=8778
